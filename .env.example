# ===========================================
# Portfolio Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Site URL (used for SEO meta tags and Open Graph)
NEXT_PUBLIC_SITE_URL=https://nandakumar.dev

# GitHub (optional - for fetching live GitHub stats)
NEXT_PUBLIC_GITHUB_USERNAME=nandakumar
GITHUB_TOKEN=

# Contact Form - EmailJS (optional)
# Get credentials at https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
